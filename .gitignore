# Worktrees
.worktrees/

# Data pipeline outputs (generated, large)
data-pipeline/output/*.db
data-pipeline/output/*.db.*-backup
data-pipeline/output/*.db.pre-*
data-pipeline/output/*.sql
data-pipeline/output/sweep_*.json
data-pipeline/output/sweep_*.md
data-pipeline/output/checkpoint_*.json
data-pipeline/output/checkpoint_*.json.pre-*
# Diagnostic / sweep result artefacts — environment-specific, regenerated
# on every snap or sweep run. They should not be committed; previous slips
# (e.g. docs(m05) gamma verdict) smuggled +45k regenerated lines into
# unrelated commits.
data-pipeline/output/snap_dropped.jsonl
data-pipeline/output/*_results.json
# Negation: re-include explicit "do not delete" sentinels (small text companion
# files placed next to a snapshot the user wants protected from automated
# pruning — e.g. lexicon_v2.db.pre-purge-20260517.keep-for-m03-baseline).
!data-pipeline/output/*.keep-for-*
data-pipeline/logs/
data-pipeline/raw/
data-pipeline/input/brysbaert-concreteness/

# Claude Code runtime state
.claude/scheduled_tasks.lock

# Python virtual env
*.venv/

# Syncing config, machine dependent
.syncignore

# SQLite databases
*.db

# Go
api/metaforge

# Python
__pycache__/
*.pyc
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp

# Node
node_modules/
dist/

# Coverage
coverage/
coverage.out
coverage.html

# Deploy generated files
*.active

