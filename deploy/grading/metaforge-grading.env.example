# Copy to /etc/default/metaforge-grading on the VPS, populate, chmod 0640.
GRADING_SECRET_FILE=/etc/metaforge/grading_secret
# NOTE: the systemd unit sets PYTHONPATH explicitly (to the .worktrees/next deploy
# worktree) and that override wins. This value is retained only for non-systemd /
# manual runs; the live service ignores it.
PYTHONPATH=/home/agent/projects/metaforge/.worktrees/next/data-pipeline/
