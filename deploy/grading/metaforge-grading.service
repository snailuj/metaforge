[Unit]
Description=Metaforge Grading Sidecar
After=network.target

# Runs as `agent`, the owner of the code worktree, the venv and the data clone, so
# git autocommit works without a second user. The sandbox below is what limits it:
# the process sees the code read-only and ONE writable tree, the data clone.
[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/projects/metaforge/.worktrees/next
EnvironmentFile=/etc/default/metaforge-grading
Environment=GRADING_DEV=
# CODE runs from the .worktrees/next deploy worktree, pinned by PYTHONPATH. NOTE: a
# PYTHONPATH in the EnvironmentFile OVERRIDES this inline value at runtime, so
# deploy.sh strips PYTHONPATH from /etc/default to leave this authoritative.
Environment=PYTHONPATH=/home/agent/projects/metaforge/.worktrees/next/data-pipeline/
# The code tree is read-only, so do not try to write .pyc files into it.
Environment=PYTHONDONTWRITEBYTECODE=1
# Grading DATA and the 15-min autocommit live in a standalone git CLONE of the
# grading-data branch (not a worktree): a worktree shares objects and refs with the
# main repo's .git, which would have to stay writable. paths.GRADING_DIR reads
# GRADING_DATA_DIR; the autocommit targets GRADING_DATA_GIT_ROOT. (If /etc/default
# ever sets these keys it would override them, like PYTHONPATH; keep them out.)
Environment=GRADING_DATA_DIR=/home/agent/projects/metaforge-grading-data/data-pipeline/grading
Environment=GRADING_DATA_GIT_ROOT=/home/agent/projects/metaforge-grading-data
# Own venv, built with hashes by deploy.sh from grading_sidecar/requirements.lock.
ExecStart=/home/agent/projects/metaforge/.worktrees/next/data-pipeline/grading_sidecar/.venv/bin/python -m grading_sidecar.main
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# ProtectSystem=strict leaves /home writable, and ProtectHome=read-only broke the
# API (SQLite, see deploy-servers memory). tmpfs empties home; the two trees the
# sidecar needs are bound back: code read-only (venv included), data clone writable.
# The clone's .git is its own directory, so the autocommit needs nothing outside it.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/agent/projects/metaforge/.worktrees/next
BindPaths=/home/agent/projects/metaforge-grading-data
ReadWritePaths=/home/agent/projects/metaforge-grading-data
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
