[Unit]
Description=Metaforge Go API (production)
After=network.target

[Service]
Type=simple
User=agent
WorkingDirectory=__WORKTREE__
# Optional: ANTHROPIC_API_KEY (and METAFORGE_FOREST_* overrides) for /forge/forest.
# Without it the route answers 503 and the rest of the API is unaffected.
EnvironmentFile=-/etc/metaforge/forest.env
ExecStart=__WORKTREE__/api/metaforge \
    -port 8080 \
    -db __WORKTREE__/data-pipeline/output/lexicon_v2.db \
    -strings __WORKTREE__/strings \
    -cors-origin https://metaforge.julianit.me
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metaforge-api
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__WORKTREE__/data-pipeline/output

[Install]
WantedBy=multi-user.target
