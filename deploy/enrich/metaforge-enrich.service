[Unit]
Description=Metaforge metaphor enrichment (grows the forest cache under the weekly budget)
After=network.target metaforge-api.service
Wants=metaforge-api.service

[Service]
Type=simple
User=metaforge
Group=metaforge
WorkingDirectory=__WORKTREE__
# Talks only to the production API, which holds the key, the cap and the
# ledger; this process never sees ANTHROPIC_API_KEY.
ExecStart=__WORKTREE__/api/enrich \
    -api http://127.0.0.1:8080 \
    -lexicon __WORKTREE__/data-pipeline/output/lexicon_v2.db \
    -top 5000 \
    -passes 10 \
    -reserve 5 \
    -state /var/lib/metaforge/enrich_state.json
# Exits 0 when its passes are done; restarts only after a failure.
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metaforge-enrich
NoNewPrivileges=true
ProtectSystem=strict
# Sandbox. Home is replaced by an empty tmpfs and only the worktree is bound back,
# read-only, so a compromised API sees neither ~/.ssh nor anything else of agent's.
# (ProtectSystem=strict alone leaves /home writable.) Writable state is only
# /var/lib/metaforge (enrich_state.json), created and owned by the unit via
# StateDirectory.
ProtectHome=tmpfs
BindReadOnlyPaths=__WORKTREE__
StateDirectory=metaforge
StateDirectoryMode=0750
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
