# Install as /etc/caddy/metaforge-next.env (root:root, 0600). Read by systemd
# for julianit-caddy.service; never commit the real values.
# Single-quote the hash: bcrypt hashes contain '$'.
# Hash: caddy hash-password --plaintext '<password>'
JULIAN_BCRYPT_HASH='$2a$14$replace-me'
# Must match GRADING_SECRET in /etc/default/metaforge-grading
GRADING_SECRET='replace-me'
