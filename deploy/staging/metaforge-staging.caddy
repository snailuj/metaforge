metaforge-next.julianit.me {
    # Healthz — public, no auth (frontend probe).
    handle /api/grading/healthz {
        reverse_proxy 127.0.0.1:53775
    }

    # Grading API — basic-auth + body cap + secret injection.
    # {$JULIAN_BCRYPT_HASH} and {$GRADING_SECRET} come from julianit-caddy.service's
    # EnvironmentFile /etc/caddy/metaforge-next.env (drop-in: caddy-secrets.conf),
    # resolved when the Caddyfile is adapted. Reload via `systemctl reload julianit-caddy`
    # so the adapting process has that environment; a bare `caddy reload` does not.
    # NOTE: per-IP rate_limit deferred — requires the caddy-ratelimit plugin,
    # which would mean rebuilding the shared Caddy binary serving all sites.
    # basic-auth already blocks crawlers; revisit if bcrypt-CPU-DoS becomes real.
    # Access logging uses Caddy's global logger (no per-handle `log` block — it
    # isn't an ordered HTTP handler inside `handle`). Global logging does not
    # record request headers by default, so the basic-auth + X-Grading-Secret
    # values stay out of the logs.
    handle /api/grading/* {
        basic_auth {
            julian {$JULIAN_BCRYPT_HASH}
        }

        request_body {
            max_size 1MB
        }

        reverse_proxy 127.0.0.1:53775 {
            header_up X-Grading-Secret {$GRADING_SECRET}
        }
    }

    # Thesaurus / Forge / Strings / Health — existing Go API.
    handle /thesaurus/* {
        reverse_proxy 127.0.0.1:8081
    }
    handle /forge/* {
        reverse_proxy 127.0.0.1:8081
    }
    handle /strings/* {
        reverse_proxy 127.0.0.1:8081
    }
    handle /health {
        reverse_proxy 127.0.0.1:8081
    }

    # Default — SPA catch-all with immutable asset cache.
    handle {
        root * __WORKTREE__/web/dist
        try_files {path} /index.html
        file_server

        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
    }

    handle_errors {
        header Cache-Control "no-store"
    }
}
